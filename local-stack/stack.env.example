# 复制为 stack.env 后填写。这些值是本地生成的随机串，不要提交到仓库。
# 生成方式（PowerShell，64 位 hex）：
#   -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })

REDIS_PASSWORD=<64 位 hex>
REDIS_TOKEN=<64 位 hex>
WM_SESSION_SECRET=<64 位 hex>
LOCAL_API_TOKEN=<64 位 hex>

# API sidecar 以 docker 模式运行：它会跳过 OLLAMA_API_URL 的主机白名单，
# 并接受明文 http 的 Upstash 兼容端点。
LOCAL_API_MODE=docker
LOCAL_API_PORT=46123
UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
UPSTASH_ALLOW_INSECURE_HTTP=true

# 翻译/摘要：应用会以 "ollama" 提供方的身份调用这个 OpenAI 兼容端点，
# 这里指向本地翻译网关（见 mt-gateway.mjs）。
OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mymemory
OLLAMA_API_KEY=local-gateway

# 网关后端：mymemory（免 key，只做翻译）或任意 OpenAI 兼容 LLM（翻译+摘要）。
MT_PROVIDER=mymemory
MT_PORT=11434

# --- 换成国内 LLM 时取消下面注释，并把 MT_PROVIDER 改成对应后端 ---
# 注意 MT_BASE 要带版本号：网关会自己拼 /chat/completions
#
# MT_PROVIDER=zhipu
# MT_BASE=https://open.bigmodel.cn/api/paas/v4
# MT_KEY=你的 key
# MT_MODEL=glm-4-flash
#
# 其它可用端点（均已实测可达）：
#   DeepSeek   https://api.deepseek.com/v1                 (deepseek-chat)
#   Kimi       https://api.moonshot.cn/v1                  (moonshot-v1-8k)
#   通义       https://dashscope.aliyuncs.com/compatible-mode/v1  (qwen-turbo)
#   硅基流动   https://api.siliconflow.cn/v1
